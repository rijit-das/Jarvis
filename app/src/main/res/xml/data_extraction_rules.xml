<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules: keep personal data off cloud backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="jarvis.db" />
        <exclude domain="sharedpref" path="jarvis_secure.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="jarvis.db" />
        <exclude domain="sharedpref" path="jarvis_secure.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
